{
  "name": "RunPi rAthReST",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/var/www/rathrest",
  "customizations": {
    "vscode": {
      "settings": {
        // PHP
        "php.validate.executablePath": "/usr/local/bin/php",
        // Editor defaults
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "bash",
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[css]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[php]": {
          "editor.tabSize": 4,
          "editor.insertSpaces": true
        }, // intelephense still formats this
        // ESLint stays lint-only — don't let it format
        "eslint.format.enable": false,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit" // still auto-fixes lint issues (unused imports etc), just not formatting
        },
        // Disable inline AI suggestions
        "editor.inlineSuggest.enabled": false,
        "github.copilot.enable": {
          "*": false
        },
        "css.validate": false,
        "scss.validate": false,
        "less.validate": false,
        "anseki.vscode-color": true,
        "color-highlight.markerType": "dot-before",
        "color-highlight.matchWords": true,
        "tailwindCSS.experimental.classRegex": [
          [
            "clsx\\(([^)]*)\\)",
            "(?:'|\"|`)([^']*)(?:'|\"|`)"
          ],
          [
            "cn\\(([^)]*)\\)",
            "(?:'|\"|`)([^']*)(?:'|\"|`)"
          ]
        ]
      },
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "naumovs.color-highlight",
        "mikestead.dotenv",
        "humao.rest-client",
        "dsznajder.es7-react-js-snippets"
      ]
    }
  }
}